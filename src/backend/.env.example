# ─────────────────────────────────────────────────────────────────────────────
# Proteus backend — local configuration
#
#   cd src/backend && cp .env.example .env
#
# Everything in this file is BACKEND ONLY. None of it is served to the browser.
# Frontend configuration lives in src/frontend/.env.example and is public.
#
# You do not need all of this at once — config is validated per feature group,
# so the server starts with what you have and names what a feature is missing:
#
#   rules engine + tests ....... nothing
#   API, database, SSE ......... CORE
#   agents ..................... CORE + GEMINI
#   build / test / sandbox ..... CORE + GEMINI + GCP + GITHUB
#   token verification ......... FIREBASE
# ─────────────────────────────────────────────────────────────────────────────

# ── CORE ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# MongoDB. A replica set is required, not optional: the SSE fan-out tails a
# change stream, and a standalone mongod cannot open one. Atlas provides a
# replica set on the free tier; local Docker needs --replSet.
MONGODB_URI=mongodb://localhost:27017/proteus?replicaSet=rs0
MONGODB_DB=proteus

# ── GEMINI ───────────────────────────────────────────────────────────────────
# Two ways in; configure exactly one.
#   1. API key   — https://aistudio.google.com/apikey
#   2. Vertex AI — set GOOGLE_GENAI_USE_VERTEXAI=true and authenticate with
#                  application-default credentials (uses GCP_PROJECT_ID below)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=false

# ── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Uploaded specs, extracted text, build logs, diffs, generated reports.
GCS_BUCKET=

# Cloud Build runs the disposable engineering environment for the repository
# under migration — not for this repository.
CLOUD_BUILD_SERVICE_ACCOUNT=

# Artifact Registry repository holding sandbox images.
ARTIFACT_REGISTRY_REPO=proteus-sandbox

# Cloud Run service name prefix for deployed sandbox applications.
SANDBOX_SERVICE_PREFIX=pqc-sandbox

# Local development authenticates with:
#   gcloud auth application-default login
# On Cloud Run the attached service account is used and this stays empty.
GOOGLE_APPLICATION_CREDENTIALS=

# ── GITHUB ───────────────────────────────────────────────────────────────────
# Fine-grained PAT, Contents: read/write, scoped to the demo repository only.
# The prototype supports one public or one pre-authorised repository (Spec §5).
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# ── FIREBASE ─────────────────────────────────────────────────────────────────
# The Admin SDK verifies ID tokens using application-default credentials, so the
# project id is all that is needed here. The web config lives in the frontend.
FIREBASE_PROJECT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Proteus backend — local configuration
#
#   cd src/backend && cp .env.example .env
#
# Everything in this file is BACKEND ONLY. None of it is served to the browser.
# Frontend configuration lives in src/frontend/.env.example and is public.
#
# You do not need all of this at once — config is validated per feature group,
# so the server starts with what you have and names what a feature is missing:
#
#   rules engine + tests ....... nothing
#   API, database, SSE ......... CORE
#   agents ..................... CORE + GEMINI
#   build / test / sandbox ..... CORE + GEMINI + GCP + GITHUB
#   token verification ......... FIREBASE
# ─────────────────────────────────────────────────────────────────────────────

# ── CORE ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# MongoDB. A replica set is required, not optional: the SSE fan-out tails a
# change stream, and a standalone mongod cannot open one. Atlas provides a
# replica set on the free tier; local Docker needs --replSet.
MONGODB_URI=mongodb://localhost:27017/proteus?replicaSet=rs0
MONGODB_DB=proteus

# Browser origins allowed to call this API. Comma-separated, exact matches.
#
# The frontend is a separate origin in every deployment shape this product has —
# Vite on :5173 locally, Cloud Run or Firebase Hosting in production — so
# without this nothing in a browser reaches the API at all. Not a wildcard:
# requests carry a Firebase ID token, and `*` on a credentialed endpoint is how
# a token ends up readable by somebody else's page.
ALLOWED_ORIGINS=http://localhost:5173

# ── GEMINI ───────────────────────────────────────────────────────────────────
# Two ways in; configure exactly one.
#   1. API key   — https://aistudio.google.com/apikey
#   2. Vertex AI — set GOOGLE_GENAI_USE_VERTEXAI=true and authenticate with
#                  application-default credentials (uses GCP_PROJECT_ID below)
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# Where Vertex serves the model. Only read when GOOGLE_GENAI_USE_VERTEXAI=true.
#
# Deliberately separate from GCP_REGION: newer Gemini models land on the
# `global` endpoint first and reach regional ones later, so tying the two would
# force a choice between the model the product requires and keeping the bucket
# and builds nearby. Those are unrelated decisions.
VERTEX_LOCATION=global

# Tech Stack §3 requires Gemini 3.5 or newer. Startup rejects anything lower.
# Confirm the exact id against the current model list before first run:
#   AI Studio model picker, or  gcloud ai models list --region=$GCP_REGION
GEMINI_MODEL=gemini-3.7-flash

# ── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Uploaded specs, extracted text, build logs, diffs, generated reports.
GCS_BUCKET=

# Cloud Build runs the disposable engineering environment for the repository
# under migration — not for this repository.
CLOUD_BUILD_SERVICE_ACCOUNT=

# Artifact Registry repository holding sandbox images.
ARTIFACT_REGISTRY_REPO=proteus-sandbox

# Cloud Run service name prefix for deployed sandbox applications.
SANDBOX_SERVICE_PREFIX=pqc-sandbox

# ── SANDBOX HOSTING (PRD-16) ─────────────────────────────────────────────────
#
# Where a verified migration's application is deployed and exercised. Every
# migration deploys and tests against a real running service — these settings
# decide where it runs and how long the shareable one is kept.
#
#   CLOUD_RUN   deploy to Cloud Run. The URL is shareable. Required when Proteus
#               itself runs on Cloud Run, which has no Docker daemon.
#   LOCAL       run the container on this host with Docker. Development only.
SANDBOX_PLACEMENT=LOCAL

# How many sandboxes are RETAINED after verification, with a shareable link.
# Not a limit on how many are deployed: past a cap the sandbox is still deployed
# and exercised end to end, then released immediately (D-020). Verification is
# never degraded by capacity — only the shareable link is.
SANDBOX_MAX_PER_USER=3
SANDBOX_MAX_TOTAL=30

# Lifecycle. A retained sandbox expires this many days after it was last opened
# through Proteus, and can never outlive the ceiling.
SANDBOX_TTL_DAYS=7
SANDBOX_HARD_TTL_DAYS=30

# Blast radius for an application that is under test and not trusted.
# min-instances is always 0 and is not configurable: it is what keeps an idle
# sandbox free, and there is no reason a sandbox would want otherwise.
SANDBOX_MAX_INSTANCES=2
SANDBOX_CPU=1
SANDBOX_MEMORY=512Mi
SANDBOX_REQUEST_TIMEOUT_SECONDS=60

# ── MIGRATION BUILD ENVIRONMENT ──────────────────────────────────────────────
#
# Spec §32 names Cloud Build as the environment that compiles, runs unit and
# integration tests, and collects execution evidence.
#
#   CLOUD_BUILD   submit to Cloud Build. Required when Proteus runs on Cloud Run.
#   LOCAL         run the build command on this host, optionally inside
#                 BUILD_IMAGE. Development only.
BUILD_EXECUTOR=LOCAL

# Where Cloud Build keeps the Maven dependency cache. Keyed by a hash of the
# repository's pom.xml, so a cold dependency tree is downloaded once per distinct
# manifest rather than once per build — measured at 33s on the reference fixture.
CLOUD_BUILD_CACHE_URI=

# Drive the agent's OWN generated tests one method at a time, so each assertion
# ticks green individually on the live feed. Applies only to suites the agent
# wrote this run — never to the repository's own suite, where running methods in
# separate JVMs would change what the tests mean and manufacture false
# regressions. Costs about 3s on the reference scenario.
#
# Failing tests already stream per method with their assertion message whatever
# this is set to; this only adds the names of PASSING methods.
SANDBOX_STREAM_GENERATED_TESTS=false

# The toolchain the repository under migration is built in. Leave empty to run
# the build command directly on this host instead of inside a container.
# The reference fixture is a Java 17 Maven project.
BUILD_IMAGE=maven:3.9-eclipse-temurin-17

# Local development authenticates with:
#   gcloud auth application-default login
# On Cloud Run the attached service account is used and this stays empty.
GOOGLE_APPLICATION_CREDENTIALS=

# ── GITHUB ───────────────────────────────────────────────────────────────────
# There is NO global GitHub token. As of UX v1.2 each project carries its own
# fine-grained PAT, entered on the create-project screen and stored in Secret
# Manager as proteus-{projectId}-github-pat. Nothing to configure here.
#
# Required scopes, as shown to the user:
#   contents: read & write · pull_requests: write · metadata: read
#
# Optional: prefill the repository fields on the create screen for demos.
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# ── FIREBASE ─────────────────────────────────────────────────────────────────
# The Admin SDK verifies ID tokens using application-default credentials, so the
# project id is all that is needed here. The web config lives in the frontend.
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# User activity and audit log (PRD-15)
# ---------------------------------------------------------------------------

# Who holds the PLATFORM_ADMIN role, and the only way it is granted.
#
# Comma-separated addresses. Reconciled at every GET /me, so adding an address
# grants the role on that user's next request and removing one revokes it. No
# endpoint grants it: a request that makes the caller an administrator is a
# privilege-escalation path in a product whose whole claim is bounded autonomy
# (D-021). Empty is a valid deployment — everyone then sees their own activity
# and nobody sees everyone's.
PLATFORM_ADMIN_EMAILS=

# A GET /me arriving after this much idle time records SESSION_STARTED. This is
# not a login: Firebase Auth is client-side and the backend never sees one.
ACTIVITY_SESSION_GAP_MINUTES=30

# Collapses one screen load's several API calls into a single page view. The
# sandbox screen makes seven on mount.
ACTIVITY_NAVIGATION_WINDOW_SECONDS=30

{
  "name": "@proteus/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p ../../tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.js --packages=external --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@genkit-ai/google-genai": "^1.41.0",
    "@google-cloud/secret-manager": "^7.0.0",
    "@google-cloud/storage": "^7.22.0",
    "@proteus/schema": "*",
    "fastify": "^5.12.1",
    "firebase-admin": "^14.3.0",
    "genkit": "^1.41.0",
    "google-auth-library": "^10.9.1",
    "mongodb": "^7.6.0",
    "unpdf": "^1.8.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.21.5",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "vitest": "^2.1.8"
  }
}

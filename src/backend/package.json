    "firebase-admin": "^14.3.0",
    "mongodb": "^7.6.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "vitest": "^2.1.8"
  }

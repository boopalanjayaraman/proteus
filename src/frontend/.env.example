# ─────────────────────────────────────────────────────────────────────────────
# Proteus frontend — local configuration
#
#   cd src/frontend && cp .env.example .env
#
# Everything here is PUBLIC. Vite inlines VITE_* variables into the bundle at
# build time, so anyone can read them in the shipped JavaScript.
#
# That is fine for what is here. Firebase web config identifies a project; it
# does not protect it. Access control lives in Firebase security rules and in
# the backend's per-project ownership checks — never in the secrecy of these
# values.
#
# Never add a Gemini key, a GitHub token, a service-account key or a database
# URI to this file. Those belong in src/backend/.env and must not be prefixed
# VITE_, or Vite will ship them to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API. In production this is the Cloud Run service URL.
VITE_API_BASE_URL=http://localhost:8080

# ── FIREBASE WEB CONFIG (public) ─────────────────────────────────────────────
# Firebase console → Project settings → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

{
  "name": "proteus",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous PQC migration agent",
  "type": "module",
  "workspaces": [
    "schema",
    "src/backend",
    "src/frontend"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @proteus/frontend",
    "dev:api": "npm run dev -w @proteus/backend"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
